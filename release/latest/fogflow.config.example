############################
#    NETWORK / HOST CONFIG #
############################

# Host IP used by FogFlow components
# Default: auto-detected via `ip route get 1.1.1.1`
# Fallback: 172.17.0.1
# HOST_IP=172.17.0.1

############################
#    EXECUTION MODE        #
############################

# Run in background (daemon)
# true  → docker compose up -d
# false → docker compose up (foreground logs)
# Default: false
# FOGFLOW_DAEMON=false

# Deployment mode
# full = designer + discovery + master + cloud_broker + cloud_worker + rabbitmq + nginx
# edge = broker + worker only
# Default: full
# FOGFLOW_MODE=full


############################
#    SITE / LOCATION       #
############################

# Geographic location of this FogFlow node
# Default: 139
# LONGITUDE=139

# Default: 35
# LATITUDE=35

# Unique site identifier
# Default: 001
# SITE_ID=001


############################
#    LOGGING CONFIG        #
############################

# Logging outputs (stdout, file, discard, etc.)
# Default: stdout
# LOG_INFO=stdout

# Default: stdout
# LOG_ERROR=stdout

# Default: stdout
# LOG_PROTOCOL=stdout

# Default: discard
# LOG_DEBUG=discard


############################
#    DISCOVERY SERVICE     #
############################

# HTTP port for discovery service
# Default: 8090
# DISCOVERY_PORT=8090

# Persist discovery data on disk
# Default: false
# DISCOVERY_STORE_ON_DISK=false

# Discovery database folder on host
# Used only when DISCOVERY_STORE_ON_DISK=true.
# Still mounted always because Docker Compose does not support conditional mounts.
# Default: /tmp/fogflow/discoveryDB
# DISCOVERY_DB_DIR=/tmp/fogflow/discoveryDB

# Delay before writing to disk (seconds)
# Default: 3
# DISCOVERY_DELAY_STORE_ON_FILE=3


############################
#    BROKER SERVICE        #
############################

# HTTP port for broker
# Default: 8070
# BROKER_PORT=8070

# Heartbeat interval (seconds)
# Default: 30
# BROKER_HEARTBEAT_INTERVAL=30


############################
#    MASTER SERVICE        #
############################

# NGSI agent port
# Default: 1060
# MASTER_NGSI_AGENT_PORT=1060

# REST API port
# Default: 8010
# MASTER_REST_API_PORT=8010

# Retry indefinitely on failure
# Default: true
# MASTER_INFINITE_RECONNECTION_TRIES=true


############################
#    WORKER CONFIG         #
############################

# Automatically remove task containers
# Default: false
# WORKER_CONTAINER_AUTOREMOVE=false

# Execute tasks immediately
# Default: true
# WORKER_START_ACTUAL_TASK=true

# Max parallel tasks
# Default: 8
# WORKER_CAPACITY=8

# Heartbeat interval (seconds)
# Default: 30
# WORKER_HEARTBEAT_INTERVAL=30

# Failure detection time (seconds)
# Default: 10
# WORKER_DETECTION_DURATION=10

# Retry indefinitely
# Default: true
# WORKER_INFINITE_RECONNECTION_TRIES=true

# Container runtime (docker / airflow)
# Default: docker
# WORKER_CONTAINER_MANAGEMENT=docker


############################
#    DESIGNER UI           #
############################

# Web UI port
# Default: 8080
# DESIGNER_WEB_PORT=8080

# Agent communication port
# Default: 1030
# DESIGNER_AGENT_PORT=1030

# LD agent port
# Default: 1090
# DESIGNER_LD_AGENT_PORT=1090

# Skip application initialization
# Default: true
# DESIGNER_DO_NOT_INIT_APPLICATIONS=true

# Designer metadata database folder on host
# Used for persisting designer metadata.
# Mounted always because Docker Compose does not support conditional mounts.
# Default: /tmp/fogflow/designerDB
# DESIGNER_DB_DIR=/tmp/fogflow/designerDB


############################
#    RABBITMQ              #
############################

# AMQP port
# Default: 5672
# RABBITMQ_PORT=5672

# Username
# Default: admin
# RABBITMQ_USER=admin

# Password
# Default: mypass
# RABBITMQ_PASS=mypass


############################
#    HTTPS CONFIG          #
############################

# Enable HTTPS
# Default: false
# HTTPS_ENABLED=false


############################
#    STORAGE               #
############################

# Persistent storage service port
# Default: 9082
# PERSISTENT_STORAGE_PORT=9082


############################
#    NGINX (ENTRYPOINT)    #
############################

# External HTTP port
# Default: 80
# NGINX_PORT=80

# Server name (nginx)
# Default: _
# NGINX_SERVER_NAME=_


############################
#    HOST PATHS (WORKER)   #
############################

# Airflow DAGs directory on host
# Default: /opt/fogflow/airflow/dags
# AIRFLOW_DAGS=/opt/fogflow/airflow/dags

# Python modules repository on host
# Default: /opt/fogflow/pymodules
# PYMODULE_REPO=/opt/fogflow/pymodules